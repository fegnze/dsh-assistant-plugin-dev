{
  "name": "@fegnze/dsh-assistant-plugin-dev",
  "version": "0.1.1",
  "description": "Portable DSH plugin development assistant with native OpenSpec and baseline-bound delivery tools",
  "license": "MIT",
  "author": "fegnze",
  "repository": {"type": "git", "url": "git+https://github.com/fegnze/dsh-assistant-plugin-dev.git"},
  "homepage": "https://github.com/fegnze/dsh-assistant-plugin-dev#readme",
  "bugs": {"url": "https://github.com/fegnze/dsh-assistant-plugin-dev/issues"},
  "publishConfig": {"access": "public", "registry": "https://registry.npmjs.org/"},
  "type": "module",
  "icon": "./icon.svg",
  "keywords": ["dsh-plugin", "dsh-assistant", "openspec"],
  "exports": {
    ".": "./src/host.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["src", "skills", "prompts", "templates", "test", "scripts", "locale", "docs", "requirements.txt", "icon.svg", "cordis.patch.yml", "README.md", "LICENSE"],
  "engines": {"node": ">=22", "dsh": "0.2.1-rc.2"},
  "peerDependencies": {"@fegnze/dsh-capability-manager": ">=0.2.0 <0.3.0", "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2"},
  "peerDependenciesMeta": {"@deepseek-ai/dsh-app-boot": {"optional": true}},
  "dependencies": {"@deepseek-ai/schemastery": "~3.18.5"},
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2"
  },
  "dsh": {"manifestVersion": 1, "bundle": {"patch": "./cordis.patch.yml"}},
  "scripts": {"test": "node --test test/*.test.mjs", "test:python": "node scripts/test-python.mjs"}
}
